
@{
    ViewData["Title"] = "Nueva Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos{

    <!-- ============================================================
    =ESTILOS PARA ESTA PAGINA
    ===============================================================-->
    <link href="~/vendor/select2/select2.min.css" rel="stylesheet">

    <style>
        .select2{
            width: 100% !important;
        }
    </style>
}


  <div class="row">
                        <div class="col-sm-8">
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3 bg-second-primary">
                                            <h6 class="m-0 font-weight-bold text-white">Cliente</h6>
                                        </div>
                                        <div class="card-body">
                                            <!-- Version Mexico (diapositivas 26 y 27): el cliente se trae por su RFC -->
                                            <input type="hidden" id="txtIdCliente" value="0">
                                            <div class="form-row">
                                                <div class="form-group col-sm-5">
                                                    <label for="txtRfcCliente">RFC</label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control text-uppercase" id="txtRfcCliente" maxlength="13" placeholder="Escriba el RFC y presione Enter">
                                                        <div class="input-group-append">
                                                            <button class="btn btn-primary" type="button" id="btnBuscarCliente" title="Buscar cliente"><i class="fas fa-search"></i></button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="form-group col-sm-7">
                                                    <label for="txtNombreCliente">Nombre</label>
                                                    <input type="text" class="form-control form-control-sm" id="txtNombreCliente" disabled>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3 bg-second-primary">
                                            <h6 class="m-0 font-weight-bold text-white">Productos</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-row">
                                                <div class="form-group col-sm-12">
                                                    <select class="form-control form-control-sm" id="cboBuscarProducto" >
                                                        <option value=""></option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-sm-12 table-responsive">
                                                    <table class="table table-striped table-sm" id="tbProducto">
                                                        <thead>
                                                            <tr>
                                                                <th></th>
                                                                <th>Producto</th>
                                                                <th class="text-right">Cantidad</th>
                                                                <th class="text-right">Precio Unitario</th>
                                                                <th class="text-right">Descuento</th>
                                                                <th class="text-right">Subtotal</th>
                                                                <th class="text-right">Impuesto</th>
                                                                <th class="text-right">Total</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>

                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="col-sm-4">

                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3 bg-second-primary">
                                            <h6 class="m-0 font-weight-bold text-white">Detalle</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="input-group input-group-sm mb-3">
                                                <div class="input-group-prepend">
                                                  <label class="input-group-text" for="cboTipoDocumentoVenta">Tipo</label>
                                                </div>
                                                <select class="custom-select" id="cboTipoDocumentoVenta">
                                                </select>
                                              </div>
                                            <div class="input-group input-group-sm mb-3">
                                                <div class="input-group-prepend">
                                                  <span class="input-group-text etiqueta-moneda" id="inputGroupImporte">Importe</span>
                                                </div>
                                                <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupImporte" id="txtImporte" disabled>
                                            </div>
                                            <div class="input-group input-group-sm mb-3">
                                                <div class="input-group-prepend">
                                                  <span class="input-group-text etiqueta-moneda" id="inputGroupDescuento">Descuento</span>
                                                </div>
                                                <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupDescuento" id="txtDescuento" disabled>
                                            </div>
                                            <div class="input-group input-group-sm mb-3">
                                                <div class="input-group-prepend">
                                                  <span class="input-group-text etiqueta-moneda" id="inputGroupSubTotal">Sub Total</span>
                                                </div>
                                                <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupSubTotal" id="txtSubTotal" disabled>
                                            </div>
                                            <div class="input-group input-group-sm mb-3">
                                                <div class="input-group-prepend">
                                                  <span class="input-group-text etiqueta-moneda" id="inputGroupIGV">IVA</span>
                                                </div>
                                                <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupIGV" id="txtIGV" disabled>
                                            </div>
                                            <div class="input-group input-group-sm mb-3">
                                                <div class="input-group-prepend">
                                                  <span class="input-group-text etiqueta-moneda" id="inputGroupTotal">Total</span>
                                                </div>
                                                <input type="text" class="form-control text-right" aria-label="Small" aria-describedby="inputGroupTotal" id="txtTotal" disabled>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="card shadow">
                                        <div class="card-body">
                                            <div class="form-group mb-0">
                                                <button class="btn btn-success btn-sm btn-block" id="btnTerminarVenta">Terminar Venta</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ventana para elegir el cliente por RFC (diapositiva 27) -->
                    <div class="modal fade" id="modalClientes" tabindex="-1" role="dialog" aria-hidden="true">
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h6>Clientes</h6>
                                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">×</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <input type="text" class="form-control form-control-sm mb-3" id="txtFiltroCliente" placeholder="Filtrar por RFC o nombre">
                                    <div style="max-height:400px; overflow-y:auto">
                                        <table class="table table-sm table-striped table-hover" id="tbClientes">
                                            <thead>
                                                <tr>
                                                    <th>RFC</th>
                                                    <th>Nombre</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @section Scripts{
                      <!-- ============================================================
    =SCRIPTS PARA ESTA PAGINA
    ===============================================================-->
    <script src="~/vendor/select2/select2.min.js"></script>
    <script src="~/vendor/select2/es.min.js"></script>

        <script src="~/js/vistas/Nueva_Venta.js" asp-append-version="true"></script>

                    }
